*.pt
*.pth
*.ckpt
*.safetensors
models/
!models/.gitkeep
checkpoints/
runs/
wandb/
mlruns/
lightning_logs/

# ── Node.js / React ───────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
frontend/.next/
frontend/dist/
frontend/build/

# ── Neo4j ────────────────────────────────────────────────
neo4j/data/
neo4j/logs/
neo4j/import/
neo4j/plugins/

# ── Docker ───────────────────────────────────────────────
docker-compose.override.yml

# ── IDEs & Editors ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────
*.log
logs/
*.pid

# ── Data ─────────────────────────────────────────────────
data/raw/
data/processed/
*.csv
!data/mock/*.csv
*.parquet
*.feather

