# ──────────────────────────────────────────────────────────────
# AtmoGraph — Frontend Development Dockerfile
# React + React Flow (Dimple's dashboard)
#
# Uses Node 20 LTS on Alpine for a lightweight dev image.
# Hot-reload (CRA or Vite) is enabled via volume mount in
# docker-compose.yml.
# ──────────────────────────────────────────────────────────────

FROM node:20-alpine AS dev

# ── System dependencies ──────────────────────────────────────
RUN apk add --no-cache git

WORKDIR /app

# ── Package dependencies (cached layer) ──────────────────────
# Copy only package files first — rebuilt only when they change.
COPY frontend/package.json frontend/package-lock.json* ./

RUN npm ci --prefer-offline 2>/dev/null || npm install

# ── Application source ───────────────────────────────────────
# Note: docker-compose volume-mounts ./frontend:/app for hot-reload,
# so this COPY is mainly for standalone `docker build` usage.
COPY frontend/ .

# ── Port ─────────────────────────────────────────────────────
EXPOSE 3000

# ── Health-check ─────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget -qO- http://localhost:3000 || exit 1

# ── Start dev server ─────────────────────────────────────────
# Works for both Create React App and Vite
CMD ["sh", "-c", "npm run dev 2>/dev/null || npm start"]
