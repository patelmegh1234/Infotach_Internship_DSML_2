# ─────────────────────────────────────────────────────────
#  AtmoGraph — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Neo4j Database ───────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=atmograph2026
NEO4J_DATABASE=neo4j

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://:atmograph2026@localhost:6379
REDIS_PASSWORD=atmograph2026

# ── HuggingFace / NLP ────────────────────────────────────
HUGGINGFACE_TOKEN=hf_your_token_here
NLP_MODEL=dslim/bert-base-NER

# ── FastAPI ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── GNN Model ────────────────────────────────────────────
MODEL_PATH=./models/gnn_model.pt
MODEL_HIDDEN_DIM=64
MODEL_NUM_LAYERS=3
MODEL_DROPOUT=0.3

# ── Frontend ─────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws

# ── News Ingestion (Optional) ────────────────────────────
NEWS_API_KEY=your_newsapi_key_here
NEWS_POLL_INTERVAL_SECONDS=300
